// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "disable_ai": true,
  "proxy": "",
  "edit_predictions": {
    "provider": "ollama"
  },
  "project_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false
  },
  "agent": {
    "enable_feedback": false,
    "threads_sidebar": {
      "auto_open": false,
      "position": "right"
    },
    "dock": "right",
    "tool_permissions": {
      "default": "confirm"
    },
    "use_modifier_to_send": false,
  },
  "ui_font_size": 22,
  "buffer_font_size": 22.0,
  "buffer_font_family": "Hack Nerd Font Propo",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Macchiato"
  },
  "base_keymap": "None",
  "auto_install_extensions": {
    //"html": true,
    //"dockerfile": true,
  },
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "*.meta",
    "**/__pycache__",
    "**/node_modules",
    "**/.ropeproject",
    "**/.ruff_cache",
    "**/.zed"
  ],
  "tabs": {
    "close_position": "right",
    "file_icons": true,
    "git_status": true,
    "activate_on_close": "left_neighbour",
    "show_close_button": "hover",
    "show_diagnostics": "off"
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false,
    "selections_menu": true
  },
  "hard_tabs": false,
  "terminal": {
    "blinking": "terminal_controlled",
    "toolbar": {
      "breadcrumbs": true
    }
  },
  "outline_panel": {
    "dock": "left",
    "button": false
  },
  "languages": {
    "Python": {
      "tab_size": 4,
      "hard_tabs": false,
      "format_on_save": "off",
      "show_completions_on_input": true,
      "language_servers": ["ty", "ruff"],
      "formatter": {
        "external": {
          "command": "ruff",
          "arguments": ["format", "--stdin-filename", "{buffer_path}", "-"]
        }
      }
    }
  },
  "lsp": {
    "ty": {
      "binary": {
        "path": "/home/maksym/.local/bin/ty",
        "arguments": ["server"]
      }
    }
  }
}
